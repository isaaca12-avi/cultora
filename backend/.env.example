# Copia este archivo como backend/.env antes de arrancar la API.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=cultora

# Seguridad (JWT_SECRET debe tener 32+ caracteres en producción)
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
CULTORA_ENV=development

# CORS: en production/staging es obligatorio y no admite "*"
CORS_ORIGINS=http://localhost:3000

# URL pública del frontend (enlaces de recuperación y verificación)
FRONTEND_URL=http://localhost:3000
AUTH_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=48
# Sólo en desarrollo: devuelve los enlaces de email en la respuesta para probar sin SMTP.
CULTORA_EXPOSE_AUTH_LINKS=false

# Correo transaccional (sin SMTP, los correos se imprimen en el log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Cultora
SMTP_STARTTLS=true
SMTP_SSL=false

# IA (opcional fuera del entorno Emergent)
EMERGENT_LLM_KEY=

# Bootstrap de admin inicial (opcional, desactivar tras usarlo)
CULTORA_BOOTSTRAP_ENABLED=false
CULTORA_BOOTSTRAP_ADMIN_EMAIL=
CULTORA_BOOTSTRAP_ADMIN_PASSWORD=
